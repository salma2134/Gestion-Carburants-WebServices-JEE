<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit name="GestionCarburantsPU" transaction-type="JTA">

        <jta-data-source>java:/jdbc/GestionCarburantsDS</jta-data-source>

        <class>ma.fstt.gestioncarburants.entities.Station</class>
        <class>ma.fstt.gestioncarburants.entities.Carburant</class>
        <class>ma.fstt.gestioncarburants.entities.HistoCarb</class>

        <properties>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>

    </persistence-unit>
</persistence>
